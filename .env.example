# PostgreSQL production store. Omit to use the single-process JSON development fallback.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/smarthub

# Worker lanes. Test execution is isolated from the other workflow queues.
# Keep the bounded defaults unless the model provider, browser host and database
# have been capacity-tested together. Each value must be between 1 and 8.
# SMARTHUB_TEST_EXECUTION_CONCURRENCY=3
# SMARTHUB_WORKFLOW_CONCURRENCY=1
# SMARTHUB_TASK_LEASE_MS=60000
# SMARTHUB_TASK_POLL_MS=1000

# Optional local model mirror.
# SMARTHUB_MODEL_HUB=https://your-hugging-face-compatible-mirror.example

# Optional roots for local runtime data.
# SMARTHUB_APP_ROOT=C:/opt/smarthub
# SMARTHUB_DATA_ROOT=D:/smarthub-data
# SMARTHUB_DATA_FILE=./data/smarthub.json
# SMARTHUB_MODEL_ROOT=./data/models
# SMARTHUB_DOCUMENT_ROOT=./data/knowledge-bases
# SMARTHUB_SKILL_ROOT=./data/skills

# Development-only bootstrap identity. It is created server-side and never reads identity from requests.
# SMARTHUB_BOOTSTRAP_SUBJECT_ID=local-developer
# SMARTHUB_BOOTSTRAP_DISPLAY_NAME=本地开发者

# Production API identity. Put the API behind a trusted reverse proxy, keep it
# bound to loopback, strip inbound x-smarthub-* headers, then inject the secret
# plus x-smarthub-subject-id/x-smarthub-display-name after authentication.
# Use at least 32 random bytes. The Worker does not need this value.
# SMARTHUB_TRUSTED_PROXY_SECRET=<at-least-32-random-bytes>

# MCP and HTTP Tool tokens are referenced by environment-variable name in the AI resource catalog.
# SMARTHUB_MCP_ISSUES_MCP_TOKEN=<access-token>
# SMARTHUB_HTTP_TOOL_ISSUES_LOOKUP_TOKEN=<bearer-token>

# Browser API prefix (build time), including /api. Defaults to same-origin /api.
# VITE_API_BASE=/api
# Vite development/preview proxy target (not embedded in the browser bundle).
# SMART_HUB_DEV_API_TARGET=http://127.0.0.1:8787
