{
  "name": "smarthub-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,WORKER,WEB \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch --import tsx server/http/server.ts",
    "start:api": "tsx server/http/server.ts",
    "start:api:dist": "node dist-server/server/http/server.js",
    "migrate": "tsx server/migrate.ts",
    "maintenance:purge-deleted-assets": "tsx server/maintenance/purge-deleted-asset-data.ts",
    "start:worker": "tsx server/worker.ts",
    "start:worker:dist": "node dist-server/server/worker.js",
    "dev:worker": "node --watch --import tsx server/worker.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:postgres": "tsx --test tests/**/*.integration.ts",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build": "tsc -b && vite build && npm run build:server",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@vitejs/plugin-react": "latest",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "mdast-util-to-string": "^4.0.0",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typebox": "1.1.38",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.1.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "9.2.4",
    "tsx": "^4.23.1",
    "typescript": "latest"
  }
}
