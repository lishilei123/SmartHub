{
  "schemaVersion": 1,
  "tools": {
    "workspace.read_file": {
      "version": "1.0.0",
      "piName": "read",
      "label": "读取工作区文件",
      "catalogName": "工作区文件读取",
      "description": "使用 read 语义，按工作区相对路径读取固定文件。每次最多读取 240 行；大文件应使用 offset/limit 续读，以保持连续 Planning Session 的上下文可压缩。只允许当前需求分析运行的只读 /workspace，实际 read 范围才可形成 Evidence。",
      "catalogDescription": "按相对路径读取需求分析运行固定的只读工作区文件。",
      "risk": "read",
      "timeoutMs": 30000,
      "idempotent": true,
      "repeatPolicy": "replay_success_once",
      "sourcePath": "server/tools/requirement-document-workspace.ts",
      "handlerKey": "workspace.read_file",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "相对于 /workspace 的文件路径。"
          },
          "offset": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000,
            "description": "从第几行开始读取，1 开始。"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240,
            "description": "本次最多读取多少行（最大 240；大文件请使用 offset 续读）。"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "workspace.grep_files": {
      "version": "1.0.0",
      "piName": "grep",
      "label": "搜索工作区正文",
      "catalogName": "工作区正文搜索",
      "description": "使用 grep 语义在只读 /workspace 内搜索文本，返回相对文件路径和行号。需求分析的 Evidence、定位与覆盖由服务端根据固定输入和 sourceTexts 生成；需要时可再用 read 核对完整上下文。",
      "catalogDescription": "固定工作区中按文本和文件模式搜索。",
      "risk": "read",
      "timeoutMs": 30000,
      "idempotent": true,
      "sourcePath": "server/tools/requirement-document-workspace.ts",
      "handlerKey": "workspace.grep_files",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "glob": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "ignoreCase": {
            "type": "boolean"
          },
          "literal": {
            "type": "boolean"
          },
          "context": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "pattern"
        ],
        "additionalProperties": false
      }
    },
    "workspace.find_files": {
      "version": "1.0.0",
      "piName": "find",
      "label": "查找工作区文件",
      "catalogName": "工作区文件查找",
      "description": "使用 find 语义，在只读 /workspace 内按 glob 查找文件和目录。只接受不会越过工作区的相对路径与模式。",
      "catalogDescription": "在固定工作区中按名称查找文件。",
      "risk": "read",
      "timeoutMs": 30000,
      "idempotent": true,
      "sourcePath": "server/tools/requirement-document-workspace.ts",
      "handlerKey": "workspace.find_files",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "required": [
          "pattern"
        ],
        "additionalProperties": false
      }
    },
    "workspace.list_directory": {
      "version": "1.0.0",
      "piName": "ls",
      "label": "列出工作区目录",
      "catalogName": "工作区目录查看",
      "description": "使用 ls 语义列出只读 /workspace 中的目录内容。省略 path、传空字符串或传 . 均表示 /workspace 根目录；非空 path 只接受工作区内相对路径。",
      "catalogDescription": "浏览固定工作区目录树。",
      "risk": "read",
      "timeoutMs": 30000,
      "idempotent": true,
      "sourcePath": "server/tools/requirement-document-workspace.ts",
      "handlerKey": "workspace.list_directory",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000,
            "description": "省略、空字符串或 . 均表示 /workspace 根目录；非空 path 只接受工作区内相对路径。"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "additionalProperties": false
      }
    },
    "knowledge.search": {
      "version": "1.1.0",
      "piName": "knowledge_search",
      "label": "固定索引检索",
      "catalogName": "固定索引检索",
      "description": "基于本次运行的 snapshot.indexVersionId，在整个知识库固定索引内执行 Hybrid/Vector 检索；正文已直接投递时只用于定向复查。",
      "catalogDescription": "基于运行固定索引，在整个知识库内执行 Hybrid/Vector 检索。",
      "risk": "read",
      "timeoutMs": 30000,
      "idempotent": true,
      "sourcePath": "server/tools/knowledge-search.ts",
      "handlerKey": "knowledge.search",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    "knowledge.read_chunk": {
      "version": "1.1.0",
      "piName": "knowledge_read_chunk",
      "label": "读取固定 Chunk",
      "catalogName": "读取固定 Chunk",
      "description": "仅在需要复核引用时按 Chunk ID 读取本次固定索引中的完整内容与定位。",
      "catalogDescription": "按 Chunk ID 读取本次固定索引的完整内容与定位。",
      "risk": "read",
      "timeoutMs": 30000,
      "idempotent": true,
      "repeatPolicy": "replay_success_once",
      "sourcePath": "server/tools/knowledge-read-chunk.ts",
      "handlerKey": "knowledge.read_chunk",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "chunkId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "chunkId"
        ],
        "additionalProperties": false
      }
    },
    "requirement-analysis.submit_result": {
      "version": "1.4.0",
      "piName": "requirement_analysis_submit_result",
      "label": "提交统一需求分析结果",
      "catalogName": "提交需求分析",
      "description": "提交 requirement-analysis/v1。一次提交包含需求基线、必要的结构化 Clarification、摘要及可选分析文档；服务端生成正式 ID、Evidence、引用、覆盖和 Markdown Artifact。",
      "catalogDescription": "提交单 Agent 需求分析结果，由服务端统一校验和生成 Artifact。",
      "risk": "internal_write",
      "timeoutMs": 30000,
      "idempotent": false,
      "sourcePath": "server/tools/requirement-analysis-submit-result.ts",
      "handlerKey": "requirement-analysis.submit_result",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "object",
            "properties": {
              "overview": {
                "type": "string",
                "maxLength": 12000
              },
              "businessGoals": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "overallAssessment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "score": {
                "type": "number"
              },
              "strengths": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "risks": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            },
            "additionalProperties": false
          },
          "requirementPoints": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 32,
                  "description": "本次提交内唯一的临时需求点 ID，格式 RP-001；Clarification 使用它建立引用，正式 ID 由服务端生成。"
                },
                "title": {
                  "type": "string",
                  "maxLength": 1000
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "sourceTexts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 4000
                  }
                },
                "coverageTarget": {
                  "type": "boolean",
                  "description": "是否描述独立可验收业务行为；项目背景、目标或解释性 Context 才能为 false。"
                },
                "coverageRationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "id",
                "description",
                "sourceTexts",
                "coverageTarget"
              ],
              "additionalProperties": false
            }
          },
          "clarifications": {
            "type": "array",
            "maxItems": 500,
            "description": "只有资料、Workspace 与 Knowledge Reference 都无法确定且会影响测试正确性的业务事实才提问。",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "category": {
                  "enum": [
                    "business_rule",
                    "boundary",
                    "expected_result",
                    "dependency",
                    "test_scope",
                    "environment",
                    "other"
                  ]
                },
                "requirementPointRefs": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 32
                  }
                },
                "blocking": {
                  "type": "boolean"
                }
              },
              "required": [
                "question",
                "reason",
                "category",
                "requirementPointRefs",
                "blocking"
              ],
              "additionalProperties": false
            }
          },
          "analysisDocument": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "required": [
          "summary",
          "requirementPoints",
          "clarifications"
        ],
        "additionalProperties": false
      }
    },
    "test_design_cases.submit_result": {
      "version": "4.1.0",
      "piName": "test_design_cases_submit_result",
      "label": "提交测试用例候选",
      "catalogName": "提交测试用例候选",
      "description": "提交 test-case-design/v3；Agent Case 使用 agentTestSpec 描述 Evidence-driven 约束，Service 负责正式治理。",
      "catalogDescription": "提交 test-case-design/v3 极简测试用例候选。",
      "risk": "internal_write",
      "timeoutMs": 30000,
      "idempotent": false,
      "sourcePath": "server/tools/requirement-tools.ts",
      "handlerKey": "test_design_cases.submit_result",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "schemaVersion": { "const": "test-case-design/v3" },
          "cases": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "properties": {
                "ref": { "type": "string", "minLength": 1, "maxLength": 200 },
                "schemaVersion": { "const": "test-case/v3" },
                "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                "dimension": { "enum": ["functional", "performance", "stability", "compatibility", "security"] },
                "priority": { "enum": ["P0", "P1", "P2", "P3"] },
                "requirementRefs": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
                "executionMethods": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["ui", "api", "agent"] } },
                "preconditions": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
                "steps": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
                "expectedResults": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
                "agentTestSpec": { "type": "object", "properties": { "input": {}, "context": { "type": "object", "additionalProperties": true }, "expectedOutcome": { "type": "string", "minLength": 1, "maxLength": 4000 }, "requiredTools": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "forbiddenTools": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "requiredActions": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "forbiddenActions": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "argumentAssertions": { "type": "array", "maxItems": 200, "items": { "type": "object", "properties": { "tool": { "type": "string" }, "path": { "type": "string" }, "operator": { "enum": ["equals", "not_equals", "contains", "matches", "exists"] }, "expected": {} }, "required": ["tool", "path", "operator"], "additionalProperties": false } }, "sequenceConstraints": { "type": "array", "maxItems": 200, "items": { "type": "object", "properties": { "before": { "type": "string" }, "after": { "type": "string" } }, "required": ["before", "after"], "additionalProperties": false } }, "businessAssertions": { "type": "array", "maxItems": 200, "items": { "type": "object", "properties": { "path": { "type": "string" }, "operator": { "enum": ["equals", "not_equals", "contains", "matches", "exists"] }, "expected": {} }, "required": ["path", "operator"], "additionalProperties": false } }, "artifactAssertions": { "type": "array", "maxItems": 100, "items": { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"], "additionalProperties": false } }, "semanticAssertions": { "type": "array", "maxItems": 100, "items": { "type": "object", "properties": { "criterion": { "type": "string" }, "expected": { "type": "string" } }, "required": ["criterion", "expected"], "additionalProperties": false } }, "safetyAssertions": { "type": "array", "maxItems": 100, "items": { "type": "object", "properties": { "criterion": { "type": "string" }, "expected": { "type": "string" } }, "required": ["criterion", "expected"], "additionalProperties": false } }, "executionConstraints": { "type": "object", "properties": { "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000 }, "maxSteps": { "type": "integer", "minimum": 1, "maximum": 10000 }, "repeatCount": { "type": "integer", "minimum": 1, "maximum": 50 }, "maxCost": { "type": "number", "minimum": 0 } }, "required": ["timeoutMs", "maxSteps", "repeatCount"], "additionalProperties": false } }, "required": ["input", "expectedOutcome", "requiredTools", "forbiddenTools", "requiredActions", "forbiddenActions", "argumentAssertions", "sequenceConstraints", "businessAssertions", "artifactAssertions", "semanticAssertions", "safetyAssertions", "executionConstraints"], "additionalProperties": false }
              },
              "required": ["ref", "schemaVersion", "title", "dimension", "priority", "requirementRefs", "executionMethods", "preconditions", "steps", "expectedResults"],
              "additionalProperties": false
            }
          }
        },
        "required": ["schemaVersion", "cases"],
        "additionalProperties": false
      }
    },
