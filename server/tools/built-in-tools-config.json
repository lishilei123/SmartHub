    "test_case_synthesis.submit_result": {
      "version": "1.1.0",
      "piName": "test_case_synthesis_submit_result",
      "label": "提交测试用例与数据需求候选",
      "catalogName": "提交测试用例候选",
      "description": "提交严格的 test-case-synthesis/v1。用例共同字段位于 cases[]，步骤与逐步期望位于 executionMethods[].steps[].action/expected，UI/API 入口位于各自 Spec；数据需求位于根级 dataRequirements[]。正式 ID、revision 和关系由服务端生成。",
      "catalogDescription": "基于批准测试点树提交结构化用例与数据需求候选。",
      "risk": "internal_write",
      "timeoutMs": 30000,
      "idempotent": false,
      "sourcePath": "server/tools/test-design-tools.ts",
      "handlerKey": "test_case_synthesis.submit_result",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "schemaVersion": { "const": "test-case-synthesis/v1" },
          "cases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "description": "批准测试点树的具象化用例。每个适用测试点必须被覆盖；角色、状态、输入分区/边界、业务分支或预期结果不同通常应拆成独立用例，不要用一条宽泛用例引用整棵子树。不要使用 preConditions、根级 steps、expectedResults、entryPoints、用例内 dataRequirements 或 testData。",
            "items": {
              "type": "object",
              "properties": {
                "schemaVersion": { "const": "test-case/v1" },
                "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
                "dimension": { "enum": ["functional", "performance", "stability", "compatibility", "security"] },
                "testPointIds": { "type": "array", "minItems": 1, "maxItems": 1000, "description": "只能填写批准树中提供的 nodeId。", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
                "priority": { "enum": ["P0", "P1", "P2", "P3"] },
                "preconditions": { "type": "array", "maxItems": 100, "description": "所有执行方式共享的前置条件。", "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
                "dataRequirementIds": { "type": "array", "maxItems": 0, "description": "综合候选中必须为空；服务端根据 dataRequirements[].caseIndexes 生成正式关联。", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
                "cleanup": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
                "dependencies": { "type": "array", "maxItems": 1000, "description": "依赖的正式用例 ID；首次综合通常为空。", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
                "executionMethods": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "description": "按 method 唯一。ui 只填写 uiSpec，api 只填写 apiSpec；每个分支独立填写步骤、检查点和就绪状态。",
                  "items": {
                    "type": "object",
                    "properties": {
                      "method": { "enum": ["ui", "api"] },
                      "uiSpec": { "type": "object", "properties": { "entry": { "type": "string", "minLength": 1, "maxLength": 2000 }, "viewport": { "type": "string", "maxLength": 100 }, "selectors": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } } }, "required": ["entry"], "additionalProperties": false },
                      "apiSpec": { "type": "object", "properties": { "method": { "type": "string", "minLength": 1, "maxLength": 20 }, "path": { "type": "string", "minLength": 1, "maxLength": 2000 }, "requestSchemaRef": { "type": "string", "maxLength": 500 }, "responseSchemaRef": { "type": "string", "maxLength": 500 } }, "required": ["method", "path"], "additionalProperties": false },
                      "steps": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "object", "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 500 }, "action": { "type": "string", "minLength": 1, "maxLength": 4000 }, "expected": { "type": "string", "minLength": 1, "maxLength": 4000 } }, "required": ["key", "action", "expected"], "additionalProperties": false } },
                      "verificationChecks": { "type": "array", "maxItems": 200, "items": { "type": "object", "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 500 }, "description": { "type": "string", "minLength": 1, "maxLength": 4000 } }, "required": ["key", "description"], "additionalProperties": false } },
                      "executionReadiness": { "enum": ["ready", "blocked", "needs_confirmation"] },
                      "automationHint": { "type": "string", "maxLength": 2000 }
                    },
                    "required": ["method", "steps", "verificationChecks", "executionReadiness", "automationHint"],
                    "additionalProperties": false
                  }
                },
                "sharedVerificationChecks": { "type": "array", "maxItems": 200, "items": { "type": "object", "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 500 }, "description": { "type": "string", "minLength": 1, "maxLength": 4000 } }, "required": ["key", "description"], "additionalProperties": false } },
                "tags": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
                "domain": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "required": ["schemaVersion", "title", "objective", "dimension", "testPointIds", "priority", "preconditions", "dataRequirementIds", "cleanup", "dependencies", "executionMethods", "sharedVerificationChecks", "tags", "domain"],
              "additionalProperties": false
            }
          },
          "dataRequirements": {
            "type": "array",
            "maxItems": 1000,
            "description": "测试数据需求只在此根级数组提交，并通过零基 caseIndexes 关联 cases[]。",
            "items": {
              "type": "object",
              "properties": {
                "ref": { "type": "string", "minLength": 1, "maxLength": 200, "description": "本次提交内唯一临时引用，不是正式 ID。" },
                "name": { "type": "string", "minLength": 1, "maxLength": 500 },
                "entityType": { "type": "string", "minLength": 1, "maxLength": 200 },
                "featureTags": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
                "testPointIds": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
                "caseIndexes": { "type": "array", "minItems": 1, "maxItems": 1000, "description": "关联 cases[] 的零基索引。", "items": { "type": "integer", "minimum": 0, "maximum": 999 } },
                "fieldConstraints": { "type": "object", "properties": {}, "additionalProperties": true },
                "relationships": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
                "quantity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                "initialState": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "preparationHint": { "type": "string", "minLength": 1, "maxLength": 4000 },
                "sensitivity": { "enum": ["public", "internal", "sensitive"] },
                "isolation": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "resetAndCleanup": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "readiness": { "enum": ["ready", "blocked", "needs_confirmation"] },
                "readinessReason": { "type": "string", "minLength": 1, "maxLength": 2000 }
              },
              "required": ["ref", "name", "entityType", "featureTags", "testPointIds", "caseIndexes", "fieldConstraints", "relationships", "quantity", "initialState", "preparationHint", "sensitivity", "isolation", "resetAndCleanup", "readiness"],
              "additionalProperties": false
            }
          }
        },
        "required": ["schemaVersion", "cases", "dataRequirements"],
        "additionalProperties": false
      }
    },
