            "maximum": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "attemptId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "artifactId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "observation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                }
              },
              "required": [
                "attemptId",
                "observation"
              ],
              "additionalProperties": false
            }
          },
          "repairable": {
            "type": "boolean"
          },
          "recommendedAction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "schemaVersion",
          "taskId",
          "scriptRevisionId",
          "attemptIds",
          "category",
          "confidence",
          "summary",
          "evidence",
          "repairable",
          "recommendedAction"
        ],
        "additionalProperties": false
      }
    },
    "script_repair.submit_result": {
      "version": "1.0.0",
      "piName": "script_repair_submit_result",
      "label": "提交测试脚本修复候选",
      "catalogName": "提交测试脚本修复候选",
      "description": "提交 script-repair/v1 单入口源码候选；服务端校验 parent Revision、诊断、修复限额、AST 和受保护断言继承。",
      "catalogDescription": "提交只读脚本修复 Stage 的 Playwright 源码候选。",
      "risk": "internal_write",
      "timeoutMs": 30000,
      "idempotent": false,
