{
  "schemaVersion": 1,
  "tools": {
    "knowledge.search": {
      "version": "1.0.0",
      "piName": "knowledge_search",
      "label": "固定索引检索",
      "catalogName": "固定索引检索",
      "description": "仅在本次运行固定的知识索引版本内检索相关 Chunk；正文已直接投递时只用于定向复查。",
      "catalogDescription": "仅在运行固定的知识索引中检索相关内容。",
      "risk": "read",
      "timeoutMs": 30000,
      "idempotent": true,
      "sourcePath": "server/tools/knowledge-search.ts",
      "handlerKey": "knowledge.search",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "minLength": 1, "maxLength": 500 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
        },
        "required": ["query"],
        "additionalProperties": false
      }
    },
    "knowledge.read_chunk": {
      "version": "1.0.0",
      "piName": "knowledge_read_chunk",
      "label": "读取固定 Chunk",
      "catalogName": "读取固定 Chunk",
      "description": "仅在需要复核引用时按 Chunk ID 读取本次固定输入中的完整内容与定位。",
      "catalogDescription": "按 Chunk ID 读取本次固定输入的完整内容与定位。",
      "risk": "read",
      "timeoutMs": 30000,
      "idempotent": true,
      "repeatPolicy": "replay_success_once",
      "sourcePath": "server/tools/knowledge-read-chunk.ts",
      "handlerKey": "knowledge.read_chunk",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "chunkId": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "required": ["chunkId"],
        "additionalProperties": false
      }
    },
    "requirement-points.submit_result": {
      "version": "5.1.0",
      "piName": "requirement_points_submit_result",
      "label": "提交需求标题、描述与原文线索",
      "catalogName": "提交需求点",
      "description": "提交 requirement-point-extraction/v5。模型正常为每条需求点生成 title，并提交 description 和 sourceTexts；title 缺失或空白时服务端根据 description 兜底，其余结构、ID、Evidence、引用、定位和覆盖清单全部由服务端生成。",
      "catalogDescription": "提交需求点提取候选结果，由服务端生成 ID 和证据关联。",
      "risk": "internal_write",
      "timeoutMs": 30000,
      "idempotent": false,
      "sourcePath": "server/tools/requirement-points-submit-result.ts",
      "handlerKey": "requirement-points.submit_result",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "requirementPoints": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "maxLength": 1000, "description": "模型生成的简洁需求点标题；缺失或空白时由服务端根据 description 兜底。" },
                "description": { "type": "string", "minLength": 1, "maxLength": 8000, "description": "可独立实现、测试或验收的原子需求描述。" },
                "sourceTexts": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 4, "maxLength": 4000, "description": "支撑当前需求点的原文或高区分度原文线索。" } }
              },
              "required": ["description", "sourceTexts"],
              "additionalProperties": false
            }
          }
        },
        "required": ["requirementPoints"],
        "additionalProperties": false
      }
    },
    "review.submit_result": {
      "version": "4.0.0",
      "piName": "review_submit_result",
      "label": "提交需求点对应分析",
      "catalogName": "提交评审分析",
      "description": "提交 requirement-review/v3。每条分析只需关联一个冻结需求点；模型给出标题、类型、严重度、置信度、影响、建议和总体摘要，服务端生成 Finding ID 并完成引用结构。",
      "catalogDescription": "提交需求点评审候选结果，由服务端校验并发布。",
      "risk": "internal_write",
      "timeoutMs": 30000,
      "idempotent": false,
      "sourcePath": "server/tools/review-submit-result.ts",
      "handlerKey": "review.submit_result",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "object",
            "properties": {
              "overallAssessment": { "type": "string", "minLength": 1, "maxLength": 100, "description": "建议使用 pass、pass_with_notes、needs_revision 或 blocked。" },
              "score": { "type": "number" },
              "strengths": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
              "risks": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } }
            },
            "additionalProperties": false
          },
          "analyses": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "requirementPointRef": { "type": "string", "minLength": 1, "maxLength": 100, "description": "必须是输入中存在的 RP-* 需求点 ID。" },
                "analysis": { "type": "string", "minLength": 1, "maxLength": 8000 },
                "title": { "type": "string", "minLength": 1, "maxLength": 300 },
                "type": { "type": "string", "minLength": 1, "maxLength": 100 },
                "severity": { "type": "string", "minLength": 1, "maxLength": 100 },
                "confidence": { "type": "number" },
                "impact": { "type": "string", "minLength": 1, "maxLength": 4000 },
                "recommendation": { "type": "string", "minLength": 1, "maxLength": 4000 }
              },
              "required": ["requirementPointRef", "analysis"],
              "additionalProperties": false
            }
          }
        },
        "required": ["analyses"],
        "additionalProperties": false
      }
    },
    "review.answer_submit": {
      "version": "1.0.0",
      "piName": "review_answer_submit",
      "label": "提交评审问答答案",
      "catalogName": "提交评审问答答案",
      "description": "提交 review-qa/v1。答案必须基于固定 ReviewRun；citations 只能填写固定上下文允许的 E-* Evidence ID。",
      "catalogDescription": "提交基于固定 ReviewRun 的问答答案、Evidence 引用和限制项。",
      "risk": "internal_write",
      "timeoutMs": 30000,
      "idempotent": false,
      "sourcePath": "server/tools/review-answer-submit.ts",
      "handlerKey": "review.answer_submit",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "answer": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "citations": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
          "limitations": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
        },
        "required": ["answer", "citations", "limitations"],
        "additionalProperties": false
      }
    },
