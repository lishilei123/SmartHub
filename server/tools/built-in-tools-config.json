              ],
              "additionalProperties": false
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "schemaVersion",
          "taskId",
          "files",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "failure_analysis.submit_result": {
      "version": "1.0.0",
      "piName": "failure_analysis_submit_result",
      "label": "提交执行失败诊断候选",
      "catalogName": "提交执行失败诊断候选",
      "description": "提交 failure-analysis/v1 候选；服务端校验任务、ScriptRevision、终态 Attempt、Artifact 证据和确定性修复策略。",
      "catalogDescription": "提交只读失败分析 Stage 的证据化诊断候选。",
      "risk": "internal_write",
      "timeoutMs": 30000,
      "idempotent": false,
      "sourcePath": "server/tools/requirement-tools.ts",
      "handlerKey": "failure_analysis.submit_result",
      "catalogVisible": true,
      "parameters": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": "failure-analysis/v1"
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "scriptRevisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "attemptIds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
