, "expected": { "type": "string" } }, "required": ["criterion", "expected"], "additionalProperties": false } }, "safetyAssertions": { "type": "array", "maxItems": 100, "items": { "type": "object", "properties": { "criterion": { "type": "string" }, "expected": { "type": "string" } }, "required": ["criterion", "expected"], "additionalProperties": false } }, "executionConstraints": { "type": "object", "properties": { "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000 }, "maxSteps": { "type": "integer", "minimum": 1, "maximum": 10000 }, "repeatCount": { "type": "integer", "minimum": 1, "maximum": 50 }, "maxCost": { "type": "number", "minimum": 0 } }, "required": ["timeoutMs", "maxSteps", "repeatCount"], "additionalProperties": false } }, "required": ["input", "expectedOutcome", "requiredTools", "forbiddenTools", "requiredActions", "forbiddenActions", "argumentAssertions", "sequenceConstraints", "businessAssertions", "artifactAssertions", "semanticAssertions", "safetyAssertions", "executionConstraints"], "additionalProperties": false }
